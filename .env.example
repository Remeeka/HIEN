# HIEN System Configuration
# Database Connection String
# PostgreSQL Connection (Primary Production Database):
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hien

# Local SQLite Fallback (used automatically if PostgreSQL instance is unreachable in offline dev):
# DATABASE_URL=sqlite:///./hien.db

# API Host & Port
HIEN_API_HOST=127.0.0.1
HIEN_API_PORT=8000

# Gemini 2.5 Flash API Key (Educational / Explanation Layer)
# GEMINI_API_KEY=your_gemini_api_key_here

# Network Policy Defaults
HIEN_MIN_NET_BENEFIT=35.0
HIEN_PLANNING_HORIZON_DAYS=14
HIEN_TRANSPORT_COST_PER_KM=1.25
HIEN_EMISSIONS_FACTOR_KG_PER_KM=0.192
HIEN_HUB_CAPACITY_ALERT_PCT=85.0
HIEN_AI_CONFIDENCE_THRESHOLD_PCT=75.0
HIEN_BASELINE_CENTRAL_COST=48.50
HIEN_BASELINE_CENTRAL_DISTANCE_KM=420.0
